# Durable notification outbox worker — EXAMPLE UNIT, NOT INSTALLED.
#
# Delivers institute attendance push notifications from the notification_outbox
# table. Runs as its own process so Firebase latency can never touch an HTTP
# request, a Gunicorn thread, or the AI Face WebSocket on port 7788.
#
# This file is tracked for review only. Installing it is a separate, deliberate
# operator action — see the deployment commands in the phase report.
#
# Order of operations when activating (verify each step before the next):
#   1. deploy the code (GitHub Actions) and confirm migration n0tb0x1a2b3c
#   2. install and start THIS worker with the feature still DISABLED, and
#      confirm its journal contains NO "[attendance] auto-attendance scheduler
#      started" line and no port 7788 bind
#   3. only then set INSTITUTE_ATTENDANCE_OUTBOX_ENABLED=true and restart

[Unit]
Description=Mecha School durable notification outbox worker
Documentation=file:///var/www/mecha-school/app/services/notification_outbox.py
After=network-online.target postgresql.service
Wants=network-online.target
# Not Requires= on the web service: delivery is independent of the web tier and
# must survive a web restart or recycle.
After=mecha-school.service

[Service]
Type=simple

# Matches the confirmed production layout. /var/www/mecha-school/.env is owned
# by root with mode 600 and is NOT loosened by this unit — running as root is
# what allows it to be read while those permissions are preserved. Group is
# www-data so any file the worker touches stays consistent with the web tier.
User=root
Group=www-data
WorkingDirectory=/var/www/mecha-school

# The SAME environment file the main application already uses. No credential is
# duplicated into this unit.
#
# systemd parses this file as plain KEY=VALUE lines. If mecha-school.service
# loads /var/www/mecha-school/.env the same way, nothing more is needed; if it
# sources it through a shell wrapper instead, mirror that here rather than
# rewriting the file.
EnvironmentFile=/var/www/mecha-school/.env

# Worker-specific overrides — MUST stay listed AFTER the shared .env above.
#
# systemd.exec(5), EnvironmentFile=: "Settings from these files override
# settings made with Environment=." So an Environment= line in this unit can
# NOT be relied on to beat the shared .env; only a later EnvironmentFile= can.
# When the same variable is set by several EnvironmentFile= entries, the files
# are read in the order listed and the LAST one wins — which is the whole
# reason this line sits here rather than above.
#
# The file is tracked in the repository and contains no secret: a credential
# PATH only. If it is missing the unit fails to start, which is the intended
# fail-closed behaviour — a worker with no pinned credential path would fall
# back to whatever the shared .env says, and that is the defect being fixed.
EnvironmentFile=/var/www/mecha-school/deploy/mecha-school-outbox-worker-environment

# Defence in depth: even if a future entry point forgets to declare its role,
# this process can never start the attendance scheduler, the AI Face WebSocket
# receiver, the Hikvision sync loop, the fee-reminder scheduler or the
# durable-push consumer. See app/lifecycle.py.
Environment=MECHA_PROCESS_ROLE=outbox-worker

Environment=FLASK_ENV=production

# GOOGLE_APPLICATION_CREDENTIALS is deliberately NOT set here with Environment=.
# The shared .env would override it. It is pinned in the worker-specific
# EnvironmentFile= listed after the .env above.

# Safe default. The worker idles harmlessly while this is false, so the unit
# may be installed and started before the feature is switched on. An
# INSTITUTE_ATTENDANCE_OUTBOX_ENABLED line in either EnvironmentFile= above
# overrides this, because EnvironmentFile= settings override Environment=.
Environment=INSTITUTE_ATTENDANCE_OUTBOX_ENABLED=false

Environment=OUTBOX_BATCH_SIZE=20
Environment=OUTBOX_POLL_SECONDS=5
Environment=OUTBOX_LEASE_SECONDS=300
Environment=OUTBOX_MAX_ATTEMPTS=5

ExecStart=/var/www/mecha-school/.venv/bin/python -m app.services.outbox_worker run

# SIGTERM makes the loop finish its current batch and settle in-flight rows
# rather than abandoning them on an expired lease.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

# One worker is the default. Two are safe — FOR UPDATE SKIP LOCKED prevents
# double-claiming — but one is enough for current volume.

# Hardening. The worker needs outbound HTTPS to Firebase and PostgreSQL only.
# ProtectHome is deliberately NOT set: it is unnecessary here and would risk
# hiding a credential path from a root-run process.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mecha-outbox

[Install]
WantedBy=multi-user.target
